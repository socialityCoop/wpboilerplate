# Application
web/app/plugins/*
!web/app/plugins/.gitkeep

# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# Ingore Understrap specific files and directories
web/app/themes/understrap/
web/app/themes/understrap-child/bower_components/
web/app/themes/understrap-child/node_modules/
web/app/themes/understrap-child/vendor/
web/app/themes/understrap-child/phpcs.xml
web/app/themes/understrap-child/dist/
web/app/themes/understrap-child/dist-product/

#Custom Plugins
!web/app/plugins/site-specific-plugin/

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml


# ------------------------------------------------------------------------
# This file specifies intentionally untracked files that Git should ignore
# - https://git-scm.com/docs/gitignore
# ------------------------------------------------------------------------

# Numerous always-ignore extensions
*.bak
*.cvs
*.db
*.diff
*.err
*.log
*.orig
*.rej
*.zip

# Ignore all files and directories starting with . or ~ or ._ or ending with ~
.*
~*
*~
._*
# but track
!.babelrc.js
!.browserslist
!.editorconfig
!.gitattributes
!.github
!.gitignore

# Ignore all files with .lock extentions
*.lock
# but track
!composer.lock

# OS or Editor files and folders
*.code-workspace
*.elc
*.esproj
*.komodoproject
*.sublime*
*.tmproj*